# Skopiuj ten plik jako .env i uzupelnij tym, co masz.
# Instrukcja krok po kroku znajduje sie w README.md.
#
# WAZNE: wartosci zostaw PUSTE, dopoki nie masz prawdziwych.
# Pusta wartosc = aplikacja dziala w trybie lokalnym (trening, cele,
# statystyki, streak) i nie probuje sie z niczym laczyc. Wpisanie tu
# wartosci "na probe" sprawi, ze aplikacja uzna backend za skonfigurowany
# i bedzie sie dobijac pod nieistniejacy adres.

# --- Supabase (darmowy plan) -> Project Settings > Data API + API Keys ---
# Potrzebne do: logowania, znajomych, rankingu i synchronizacji miedzy telefonami.
# Przyklad: https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Sign-In -> Google Cloud Console > Credentials ---
# Web client ID jest potrzebny ZAWSZE (to nim Supabase weryfikuje token).
# Przyklad: 000000000000-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Ponizsze dwa - tylko jesli budujesz wersje na iPhone.
# GOOGLE_IOS_URL_SCHEME to iOS client ID zapisany od tylu, np.
# com.googleusercontent.apps.000000000000-yyyyyyyyyyyyyyyy
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# --- EAS (build w chmurze) ---
# Ten identyfikator wypisze `npx eas-cli init`. Skopiuj go tutaj.
EAS_PROJECT_ID=
