# Skopiuj ten plik jako .env i uzupelnij wartosciami ze swoich kont.
# Instrukcja krok po kroku znajduje sie w README.md.

# --- Supabase (darmowy plan) -> Project Settings > Data API + API Keys ---
EXPO_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=twoj_publiczny_klucz_anon

# --- Google Sign-In -> Google Cloud Console > Credentials ---
# Web client ID jest potrzebny ZAWSZE (Supabase weryfikuje nim token).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# iOS client ID + odwrocony URL scheme - tylko jesli budujesz na iPhone.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-yyyyyyyyyyyyyyyyyyyy.apps.googleusercontent.com
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.000000000000-yyyyyyyyyyyyyyyyyyyy

# --- EAS (tylko jesli budujesz w chmurze) ---
EAS_PROJECT_ID=
